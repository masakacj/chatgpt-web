{
  "manifest_version": 3,
  "name": "ChatGPT Web Optimizer",
  "description": "Automatically applies the lightweight ChatGPT Web optimization runtime on chatgpt.com.",
  "version": "0.4.25",
  "permissions": [],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
